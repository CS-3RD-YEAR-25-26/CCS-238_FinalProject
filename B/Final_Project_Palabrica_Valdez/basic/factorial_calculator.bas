10 DIM RESULT AS LONG, COUNTER AS LONG
20 INPUT "Enter a whole number (0-12): ", N
30 IF N < 0 OR N > 12 THEN GOTO 140
40 IF N <> INT(N) THEN GOTO 140
50 RESULT = 1
60 COUNTER = 1
70 IF COUNTER > N THEN GOTO 120
80 RESULT = RESULT * COUNTER
90 COUNTER = COUNTER + 1
100 GOTO 70
120 PRINT "Result: "; RESULT: END
140 PRINT "Enter a whole number from 0 to 12."
150 END
