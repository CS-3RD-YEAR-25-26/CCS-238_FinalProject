begin
    ! the class header lists formal parameters, with their types declared before the begin block.;
    class Pokemon(pokemonName, health, damage);
        text pokemonName;
        integer health, damage;
    begin
        ! the value clause passes a copy of the integer argument to the procedure.;
        procedure receiveDamage(amount);
            value amount;
            integer amount;
        begin
            health := health - amount;

            if health < 0 then
                health := 0;
        end;

        ! a procedure with no formal parameters is called without parentheses.;
        procedure displayInfo;
        begin
            outtext(pokemonName);
            outtext(" - HP: ");
            outint(health, 0);
            outimage;
        end;
    end;

    ! ref(Pokemon) declares variables that can hold references to Pokemon instances.;
    ref(Pokemon) pikachu, charizard;

    ! new creates an instance with the supplied class arguments, and :- assigns its reference.;
    pikachu :- new Pokemon("Pikachu", 100, 30);
    charizard :- new Pokemon("Charizard", 150, 50);

    ! outtext appends the heading to the output image, and outimage writes it as a line.;
    outtext("===== BEFORE BATTLE =====");
    outimage;

    pikachu.displayInfo;
    charizard.displayInfo;

    ! dot notation selects an attribute or procedure on the referenced object.;
    charizard.receiveDamage(pikachu.damage);
    pikachu.receiveDamage(charizard.damage);

    ! the same references expose the health values updated by the procedure through :=.;
    outimage;
    outtext("===== AFTER BATTLE =====");
    outimage;

    pikachu.displayInfo;
    charizard.displayInfo;
end