begin
    ! declare text and integer variables before the executable statements of the begin block.;
    text pokemonName;
    integer pokeballs;

    ! the :- operator assigns a text reference, while := assigns an integer value.;
    pokemonName :- "Mewtwo";
    pokeballs := 0;

    ! outtext and outint append to the output image, and outimage writes the line.;
    outtext("===== POKEMON ENCOUNTER =====");
    outimage;

    outtext("A wild ");
    outtext(pokemonName);
    outtext(" appeared!");
    outimage;

    outtext("Available Pokeballs: ");
    outint(pokeballs, 0);
    outimage;

    ! this example handles errors with if and else branches. begin and end group multiple statements in a branch.;
    if pokeballs < 0 then
    begin
        ! the < operator produces the boolean condition used by the first branch.;
        outtext("Error: Invalid Pokeball quantity.");
        outimage;

    end else if pokeballs = 0 then
    begin
        ! a single = compares integer values in the else if condition.;
        outtext("Error: No Pokeballs available.");
        outimage;

        outtext("Unable to catch Pokemon.");
        outimage;

    end else
    begin
        ! the final else runs when the previous conditions are false, and := stores the new integer value.;
        pokeballs := pokeballs - 1;

        outtext("Pokeball thrown successfully!");
        outimage;

        outtext("Remaining Pokeballs: ");
        outint(pokeballs, 0);
        outimage;
    end;
end